# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# --- Model: any OpenAI-compatible chat-completions endpoint ------------------
LLM_API_KEY=
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=gemma-2-2b

# --- Runtime mode -------------------------------------------------------------
# local  : thread pool in the API process, in-memory checkpoints (no services needed)
# celery : Celery workers + Redis Stack checkpoints (run `docker compose up -d redis`)
TASK_BACKEND=local
# RediSearch (needed by the checkpointer) only works on database 0.
REDIS_URL=redis://localhost:6379/0

# sqlite   : embedded file store, FTS5 + NumPy vectors (no services needed)
# pgvector : PostgreSQL + pgvector (run `docker compose up -d postgres`)
VECTOR_STORE=sqlite
SQLITE_PATH=data/documents.db
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_orchestration

# --- Retrieval ----------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SEED_SAMPLE_DOCUMENTS=true

# --- Approvals ------------------------------------------------------------------
# Optional. When empty, approvals are accepted from loopback clients only.
APPROVAL_API_KEY=
